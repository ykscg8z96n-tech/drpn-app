# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/drpn

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Cloudinary Configuration (get from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Comma-separated list of extra allowed CORS origins beyond localhost dev
# origins (which are always allowed). Add your deployed web app's origin
# here, e.g.:
# ALLOWED_ORIGINS=https://drpn-app-steel.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=

# Your deployed web app's base URL, used to build links sent in emails
# (password reset, event invites). No trailing slash.
FRONTEND_URL=https://drpn-app-steel.vercel.app

# Resend (resend.com) API key for sending transactional emails (password
# reset). Without it, reset links are only logged to the server console -
# fine for local dev, not for production.
RESEND_API_KEY=
# Must be a verified sender on your Resend account/domain, or the default
# resend.dev sandbox address below (limited to your own verified email
# until you verify a domain).
RESEND_FROM_EMAIL=DRPN <onboarding@resend.dev>

# Web Push (browser/PWA push notifications) VAPID keypair - free, no
# account/billing needed. Generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without these, push notifications are silently skipped (message
# delivery itself is unaffected - this only disables the "someone
# messaged you while your app was closed" notification).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Slack incoming webhook URL for growth notifications (e.g. new signups).
# Create one at https://api.slack.com/apps > your app > Incoming Webhooks.
# Without it, these notifications are silently skipped.
SLACK_GROWTH_WEBHOOK=